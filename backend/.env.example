# 本地开发默认用 SQLite,零配置。部署时换成 Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./tracker.db

# mock interview 的 follow-up 生成 + code review(可选,不填则这些功能降级)
ANTHROPIC_API_KEY=

# 部署到公网时设一个,前端要带 X-API-Key 头;本地留空 = 不校验
API_KEY=

# 每日队列上限
DAILY_REVIEW_CAP=4
DAILY_NEW_CAP=3
